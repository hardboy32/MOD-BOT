# Store real values only in Railway Variables or a local .env file.
LOG_LEVEL=INFO
# Enable the optional shared dashboard (preview foundation).
DASHBOARD_ENABLED=false
ALLOW_SIGNUPS=false
APP_ENV=production
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key permanently; changing it makes saved encrypted tenant settings unreadable.
TENANT_ENCRYPTION_KEY=
# On Railway, mount a persistent volume at /data and use this path.
DATABASE_PATH=/data/modbot.sqlite3
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
KICK_WEBHOOK_URL=https://YOUR-RAILWAY-DOMAIN/webhooks/kick
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Add one access and refresh token variable pair per connected Kick channel
# Optional global VIP/moderator usernames, comma-separated
MODBOT_EXEMPT_USERS=
