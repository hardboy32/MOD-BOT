# Copy to .env locally or configure these as Railway Variables.
# Never commit real OAuth tokens.
LOG_LEVEL=INFO
ENABLED_PLATFORMS=twitch

# Twitch IRC bot account OAuth token (format: oauth:...)
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_CHANNEL=

# Optional: comma-separated moderator/VIP usernames exempt from automatic moderation
MODBOT_EXEMPT_USERS=
