# Copy to .env locally or configure these as Railway Variables.
# Never commit real OAuth tokens.
LOG_LEVEL=INFO

# Twitch IRC bot account OAuth token (format: oauth:...)
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=

# YouTube OAuth access token (if a YouTube connection is configured)
YOUTUBE_ACCESS_TOKEN=

# Optional global VIP/moderator usernames, comma-separated
MODBOT_EXEMPT_USERS=
